# Chiave API Groq (estrazione documenti). Vedi https://console.groq.com/
GROQ_API_KEY=

# Modello vision Groq usato per l'estrazione. Opzionale: se vuoto usa il default
# in app/groq_estrattore.py (qwen/qwen3.6-27b, verificato funzionante il
# 2026-07-21 — controllare https://console.groq.com/docs/vision se cambia).
GROQ_MODEL=

# Cartella dove vengono salvati i PDF delle pratiche confermate (deve rientrare nel backup dell'ufficio)
OUTPUT_FOLDER=./output

# Chiave segreta per la firma dei cookie di sessione (itsdangerous). Generarne una nuova per ogni installazione, es.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
